GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Required for video creation/download. Enter this key in the phone's Settings.
GAMECLIP_API_KEY=
# Up to 2 GiB per source video by default; raise only when server storage permits.
MAX_VIDEO_UPLOAD_BYTES=2147483648
PUBLIC_BASE_URL=https://gameclip-publisher.onrender.com
DATA_DIR=/tmp/gameclip-data
# Set these true only on a single always-on instance with a mounted persistent disk.
PERSISTENT_STORAGE_CONFIRMED=false
SCHEDULER_ENABLED=false
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=
